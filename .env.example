# ═══════════════════════════════════════════════════════════════
#  SAMUHIK AI — Environment Configuration
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ─── Mode ──────────────────────────────────────────────────────
# Set to "false" for production. Defaults to "true" when missing —
# demo mode uses localStorage only, no Supabase, no real AI key needed.
VITE_DEMO_MODE=true

# ─── Supabase (required when VITE_DEMO_MODE=false) ─────────────
# Found at: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Gemini AI (required for live AI replies) ──────────────────
# Get a free key at: aistudio.google.com → Get API Key
# Server-side only — set in Netlify dashboard, NOT prefixed with VITE_
GEMINI_API_KEY=your-gemini-key-here

# ─── POS Sync Authentication ───────────────────────────────────
# Shared secret between Samuhik and your POS system.
# POS must send this in the x-api-key request header.
# Generate a strong random string, e.g.: openssl rand -hex 32
# Server-side only — set in Netlify dashboard
SAMUHIK_POS_API_KEY=generate-a-long-random-string-here

# ─── Supabase Service Role Key (server-side only) ──────────────
# Required for the pos-sync Netlify function to write inventory data,
# bypassing Row Level Security. NEVER expose to the browser.
# Found at: supabase.com → your project → Settings → API → service_role
# Server-side only — set in Netlify dashboard
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
